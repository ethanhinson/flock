# The whole model file, cached by kernels/real_weights.ts so the coordinator and a
# simulated bird do not re-download 639MB per run. Not a build artifact: every
# device fetches its own bytes from the model host, this is just a download that
# need not repeat.
kernels/.cache

# The ONNX export of the same model that kernels/test_model.ts diffs the WGSL
# engine against. It is the only independent reference in the repo and it is
# gigabytes, so it lives here untracked; the test skips when it is absent.
kernels/.ref

# The self-signed certificate `npm run cert` writes. A private key, so never
# tracked; each machine makes its own.
.certs/

# The coordinator's durable state: the conversation journal (token ids and the
# f16 activations that left its layers) and the sessions it issued, so a restart
# resumes the conversation and the devices re-attach. Per machine, never tracked.
.state/

node_modules/
.DS_Store

# Per-scenario module shims written and unlinked by test/unit/bird_gguf.test.mjs.
# Ignored so an interrupted run cannot leave one staged.
test/unit/.*-shim-*.mjs

# agent worktrees
.claude/worktrees/

# The ONNX regression reference (web/coord/, ~2.7 GB) is regenerated locally by
# kernels/onnx_truth.mjs and is only used by test_model.ts / test_onnx.ts, which
# skip when it is absent. It must never be committed: 2.8 GB of it in history is
# what made pushes time out once already.
web/coord/
web/*.onnx
web/*.onnx.data
