# Weight cache. Every device fetches its own bytes from the model host, so
# nothing here is a build artifact -- it is just a download that need not repeat.
kernels/.cache

.DS_Store
.venv/

# Node / Deno
node/node_modules
# Per-scenario module shims written and unlinked by node/test/bird_gguf.test.mjs.
# Ignored so an interrupted run cannot leave one staged.
node/test/.*-shim-*.mjs

# agent worktrees
.claude/worktrees/

# ONNX build artifacts. These are GONE from the runtime (the engine is WGSL on
# streamed GGUF) but kernels/onnx_truth.mjs can still regenerate them as a
# dev-only reference. They are gigabytes; they must never be committed again --
# 2.8GB of them in history is why pushes started timing out.
web/coord/
web/*.onnx
web/*.onnx.data
.certs/
